#!/usr/bin/env python3
"""cua-bridge-log — read the CUA bridge's structured audit log.

The consumer half of the audit-line contract (#1597): the bridge writer
(`cua/bin/cua-bridge.py`) emits `ts= level= kind= msg=` one-line events
through `log_bridge_event`; this reader is the operator-facing tool that
parses, filters, and displays them.

Contract rules (shared with the writer — never re-derived here):
  - Parsing is done by the writer's own `_parse_bridge_event`, imported
    from cua-bridge.py — there is exactly one parser, not two assumptions.
  - Lines the parser rejects (legacy free-form diagnostics, malformed
    audit lines) are SKIPPED, never parsed. The keepalive's own startup
    banner and the sink's failure warnings share this file.
  - `msg` arrives unescaped by the parser; this tool displays the real
    message, with multi-line messages indented for readability.
"""

import argparse
import contextlib
import datetime as _dt
import importlib.util as _ilu
import io as _io
import os
import re
import sys

_BIN_DIR = os.path.dirname(os.path.abspath(__file__))


def _load_bridge_module():
    spec = _ilu.spec_from_file_location(
        "cua_bridge", os.path.join(_BIN_DIR, "cua-bridge.py"))
    mod = _ilu.module_from_spec(spec)
    # Importing the writer runs its module-level sandbox-env load, which
    # prints an "untrusted" warning on stderr — noise this reader never
    # needs (it imports only the audit-line parser). Quarantine stderr
    # across the import; if the import itself fails, the captured noise
    # is replayed before the failure propagates so it stays diagnosable.
    buf = _io.StringIO()
    try:
        with contextlib.redirect_stderr(buf):
            spec.loader.exec_module(mod)
    except Exception:
        sys.stderr.write(buf.getvalue())
        raise
    return mod


_BRIDGE = _load_bridge_module()
_parse_bridge_event = _BRIDGE._parse_bridge_event
_LEVELS = _BRIDGE._AUDIT_LEVELS
_GENERATIONS = _BRIDGE.AUDIT_LOG_GENERATIONS
_DEFAULT_LOG = _BRIDGE.AUDIT_LOG_PATH

_RELATIVE_RE = re.compile(r"^(\d+)([smhd])$")


def _event_dt(ts):
    """UTC datetime for an audit ts, or None when it is outside the
    platform's representable range (out-of-range ts values reach the
    reader through hand-written or corrupted log lines)."""
    try:
        return _dt.datetime.fromtimestamp(ts, tz=_dt.timezone.utc)
    except (OSError, OverflowError, ValueError):
        return None


def _parse_since(spec, now):
    """Turn a --since SPEC into a timezone-aware datetime cutoff.

    Relative form Ns|Nm|Nh|Nd (e.g. 30m, 24h) is measured back from `now`;
    anything else is parsed as ISO-8601, naive treated as UTC. Raises
    ValueError on anything else."""
    text = (spec or "").strip()
    m = _RELATIVE_RE.match(text)
    if m:
        amount, unit = int(m.group(1)), m.group(2)
        delta = {"s": _dt.timedelta(seconds=amount),
                 "m": _dt.timedelta(minutes=amount),
                 "h": _dt.timedelta(hours=amount),
                 "d": _dt.timedelta(days=amount)}[unit]
        return now - delta
    try:
        dt = _dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        raise ValueError(f"bad --since: {spec!r} (want Ns/Nm/Nh/Nd "
                         "or ISO-8601, e.g. 24h or 2026-10-17T10:00:00Z)")
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=_dt.timezone.utc)
    return dt


def _log_paths(base, include_rotated):
    """Log paths in oldest-first order. Rotated generations `.N` (oldest)
    down to `.1` come before the current file; missing ones are filtered
    by the caller."""
    paths = []
    if include_rotated:
        for i in range(_GENERATIONS, 0, -1):
            paths.append(f"{base}.{i}")
    paths.append(base)
    return paths


def _format_event(ev):
    """Render one parsed event: ISO ts, level, kind, then the unescaped
    message; multi-line messages get continuation lines indented. A ts
    outside the platform's range falls back to the raw integer (the event
    is still worth showing)."""
    when = _event_dt(ev["ts"])
    ts = when.strftime("%Y-%m-%dT%H:%M:%SZ") if when is not None \
        else str(ev["ts"])
    # splitlines() (not split("\n")) so \r / U+2028 line boundaries the
    # writer escapes don't leak through as raw carriage returns.
    lines = ev["msg"].splitlines() or [""]
    head = f"{ts} {ev['level']} {ev['kind']} "
    return head + lines[0] + "".join("\n    " + line for line in lines[1:])


def _iter_events(paths, kinds, levels, cutoff):
    """Yield parsed events from the paths in order, applying the contract
    skip rule (parser rejects -> skip) and the operator's filters. The
    LAST path is the primary log: if it is missing the failure is loud;
    missing rotated generations are skipped silently."""
    for index, path in enumerate(paths):
        primary = index == len(paths) - 1
        try:
            fh = open(path, "r", encoding="utf-8", errors="replace")
        except FileNotFoundError:
            if primary:
                raise OSError(f"cannot read {path}: no such file")
            continue  # rotation generation not present — not an error
        except OSError as exc:
            raise OSError(f"cannot read {path}: {exc.strerror or exc}")
        with fh:
            for line in fh:
                try:
                    ev = _parse_bridge_event(line)
                except (ValueError, TypeError):
                    continue  # contract: skip, never parse
                if kinds and ev["kind"] not in kinds:
                    continue
                if levels and ev["level"] not in levels:
                    continue
                if cutoff is not None:
                    when = _event_dt(ev["ts"])
                    if when is None or when < cutoff:
                        # Out-of-range ts cannot be compared against the
                        # cutoff — skip, per the contract's skip rule.
                        continue
                yield ev


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="cua-bridge-log",
        description="Read the CUA bridge's structured audit log "
                    "(~/.cache/cua-bridge.log): filter by kind/level, "
                    "tail by time. Lines the audit-line contract rejects "
                    "are skipped silently.")
    ap.add_argument("--log", default=_DEFAULT_LOG, metavar="PATH",
                    help="audit log path (default: %(default)s)")
    ap.add_argument("--kind", action="append", default=[], metavar="KIND",
                    help="show only this event kind; repeatable")
    ap.add_argument("--level", action="append", default=[],
                    metavar="LEVEL", choices=_LEVELS,
                    help="show only this level; repeatable")
    ap.add_argument("--since", metavar="SPEC",
                    help="show events at or after SPEC: Ns|Nm|Nh|Nd ago "
                         "(e.g. 24h) or ISO-8601 UTC "
                         "(e.g. 2026-10-17T10:00:00Z)")
    ap.add_argument("--tail", type=int, default=None, metavar="N",
                    help="show only the last N matching events")
    ap.add_argument("--all", action="store_true",
                    help="also read rotated generations "
                         "(.1 .. .N), oldest first")
    args = ap.parse_args(argv)
    if args.tail is not None and args.tail < 1:
        ap.error("--tail needs a positive integer")
    now = _dt.datetime.now(_dt.timezone.utc)
    if args.since is not None:
        try:
            cutoff = _parse_since(args.since, now)
        except ValueError as exc:
            ap.error(str(exc))
    else:
        cutoff = None
    paths = _log_paths(os.path.expanduser(args.log), args.all)
    try:
        events = list(_iter_events(paths, args.kind, args.level, cutoff))
    except OSError as exc:
        print(f"cua-bridge-log: {exc}", file=sys.stderr)
        return 1
    if args.tail is not None:
        events = events[-args.tail:]
    out = sys.stdout
    try:
        for ev in events:
            out.write(_format_event(ev) + "\n")
    except BrokenPipeError:
        # `cua-bridge-log big.log | head`: the consumer closed the pipe
        # early — that is not a failure, so exit cleanly instead of
        # dumping a traceback.
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
