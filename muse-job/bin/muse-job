#!/usr/bin/env python3
"""muse-job: manage persistent Muse Code job sessions.

Same vocabulary as the other agents this operator manages:
  spawn  - start a job (like subagent.spawn / browser.spawn_task)
  steer  - send a message into a running job (like browser.steer_task)
  status - inspect one job (like subagent.list, single)
  list   - all jobs
  log    - recent terminal output
  kill   - kill the tmux session and reap its process tree; records the
           terminal-ish "killed" state (the watchdog will not auto-revive
           it -- deliberate re-activation is `resume`)
  resume - recover a dead tmux session via `muse resume`
  close  - terminal: archive the job, remove its worktree
  watch  - watchdog pass over active jobs (cron: JSON lines)

Turn/state detection comes from the `muse-job` Muse plugin's Stop/SessionEnd
hooks, which append machine-readable events to
~/.local/share/muse-job/events/<session-uuid>.jsonl. The pane is additionally
read for steer-delivery verification, the issue-#4 dead-pane refusal, and the
watchdog's binary TUI-liveness probe (live / resume-banner / dead) -- never
for turn content.
"""
import argparse
import fcntl
import json
import os
import re
import shutil
import signal
import sqlite3
import stat
import subprocess
import sys
import time

# --- spark-vm version stamping (docs/VERSIONING.md) ---
# Best-effort: a missing/invalid VERSION must never break the CLI.
_SV_HERE = os.path.dirname(os.path.abspath(__file__))
_SV_CAND = os.path.normpath(os.path.join(_SV_HERE, "..", "..", "scripts"))
if os.path.isfile(os.path.join(_SV_CAND, "sparkvm_version.py")):
    if _SV_CAND not in sys.path:
        sys.path.insert(0, _SV_CAND)
elif _SV_HERE not in sys.path:
    sys.path.insert(0, _SV_HERE)
try:
    from sparkvm_version import sparkvm_version as _sv_fn
    SPARKVM_VERSION = _sv_fn(start=_SV_HERE)
except Exception:
    # Best-effort stamp (SyntaxError included): a broken reader or VERSION
    # must never break the component's startup.
    SPARKVM_VERSION = "0.0.0-unknown"
# --- end version stamping ---

HOME = os.path.expanduser("~")
JOBS_DIR = os.path.join(HOME, "muse-jobs")
REPOS_DIR = os.path.join(HOME, "repos")
EVENTS_DIR = os.path.join(HOME, ".local", "share", "muse-job", "events")

SESSIONS_DIR = os.path.join(HOME, ".local", "share", "muse-job", "sessions")
SESSION_INDEX = os.path.join(HOME, ".local", "share", "muse", "session-index.db")
VIEW_DIR = os.path.join(HOME, ".local", "share", "muse", "sessions", ".msp-view-v1")
MUSE = os.path.join(HOME, ".local", "bin", "muse")

# Issue #699: TUI auto-update policy while a job is active. The `muse`
# launcher (~/.local/bin/muse on a provisioned box is a bash launcher)
# stages a new versioned binary in the background at startup: it checks
# `.muse-update-checked-at` against MUSE_UPDATE_INTERVAL_SECONDS (default
# 3600) and, when due, downloads the new `muse-bin-<version>` into the
# shared install dir, flips `.muse-version`, deletes the old binaries, and
# leaves a `.muse-update-notice` the next run reports. A TUI that notices
# the staged update restarts itself mid-turn -- the pane's foreground
# process name changing (muse-bin-1.3.0-R3233.1 -> -R3401.1) is exactly
# what the watchdog's `tui-updated` event detects (issue #212).
#
# The launcher's own source gates the whole check+download on the
# environment: `[[ "${MUSE_NO_AUTO_UPDATE:-0}" != 1 ]] &&
# should_check_for_update ...` -- with MUSE_NO_AUTO_UPDATE=1 set, the
# process tree never stages an update, and a missing binary fails loud
# ("installed binary is missing; rerun the installer") instead of
# self-healing. That is the deferral half of #212's policy question,
# grounded rather than guessed. It is per-process-tree, not per-install:
# a concurrent `muse` invocation by the same user (another job's TUI, the
# operator's own shell) can still stage an update into the shared install
# dir, so the watchdog's `tui-updated` event stays as the diagnostic for
# the residual case. If a future launcher stops honoring this var, the
# same event is the canary.
_TUI_NO_AUTO_UPDATE = "MUSE_NO_AUTO_UPDATE=1"


def _tui_launch_prefix():
    """Env prefix suppressing the muse launcher's auto-update for one TUI.

    Prepended to every TUI launch command muse-job owns (spawn, resume,
    resume-fallback relaunch): while a job is active its TUI never stages
    a mid-turn update. See _TUI_NO_AUTO_UPDATE for the grounding and the
    residual risk.
    """
    return _TUI_NO_AUTO_UPDATE + " "


def _tui_launch_cmd(*argv):
    """Build the TUI command line for a tmux pane, update-deferred.

    argv are the muse subcommand words (already shell-quoted where needed);
    the result is a single shell command string with the #699 env prefix.
    """
    return _tui_launch_prefix() + "muse " + " ".join(argv)

# ANSI/OSC escapes + C0 controls. Event `detail` fields are agent-influenced
# text stored in the event log and echoed into operator-visible output
# (status, watch pages); a forged line could otherwise erase or spoof the
# security labels on those lines (issue #3 review). Mirrors the sanitizer in
# plugin/hooks/stop.py, which cleans hook-written fields at the source --
# this one covers forged event lines that bypass the hooks entirely.
# Issue #23 B6: also strip CR (\x0d, excluded from the C0 range before)
# and bare ESC sequences (\x1bc terminal reset, \x1b7/\x1b8, \x1bM, \x1b(X
# charset shifts) -- a forged detail of "\r" + padding in `muse-job status`
# (terminal f-string) overwrote the rendered line and displayed a fake
# verified-done label. The bare-\x1b alternative is ordered AFTER CSI/OSC
# so full sequences are consumed whole, not left as garbage tails.
# Final security review: C1 control range \x80-\x9f (e.g. \x9b2K, the 8-bit
# form of CSI) erased/spoofed terminal output just like C0 -- strip it too.
_ANSI_RE = re.compile(
    r"\x1b\[[0-9;?]*[ -/]*[@-~]"
    r"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"
    r"|\x1b"
    r"|[\x00-\x08\x0b\x0c\r\x0e-\x1f\x7f\x80-\x9f]"
)


def _clean_text(s):
    return _ANSI_RE.sub("", s if isinstance(s, str) else "")


# Issue #9: secret scanning on the operator->agent funnel. The spawn prompt
# is written to prompt.md and typed into the TUI at launch; every steer
# message is pasted into the TUI and persisted in the agent's session store
# on disk, same-user readable. The "agent never sees real secrets" standing
# property rests entirely on operator discipline at exactly these two
# chokepoints, so both are scanned for secret-shaped text and refused unless
# the operator passes --allow-secrets (explicit confirmation).
#
# This is a tripwire for the most common accidental pastes, NOT a
# guarantee: unpadded prefix-less entropy-only blobs (AWS secret access
# keys, raw hex tokens, unpadded base64) cannot be caught by regex --
# padded base64 blobs of 32+ chars (including 88-char padded Azure
# storage keys) ARE caught by the "long base64 credential blob" pattern
# below. And the control
# guards only the TUI/session-store funnel: the spawn prompt FILE lives on
# the box (readable by the same-user agent regardless of this scan), and
# the steer message travels via ssh argv, visible in `ps` for a moment
# even when the gate refuses it.
#
# Findings report only pattern LABELS and counts -- never the matched text --
# so a refusal message can be pasted anywhere without itself leaking the
# secret. The hsurr:<name> placeholder is the sanctioned carrier: text that
# only carries placeholders scans clean. The placeholder name charset is
# deliberately constrained and placeholder names are themselves scanned --
# otherwise hsurr: would be a secret-smuggling channel (an unregistered
# "name" like hsurr:sk-<key> stays literal in the TUI, defeating both the
# scan and the proxy swap).
_SECRET_PATTERNS = [
    ("OpenAI-style API key", re.compile(r"\bsk-[A-Za-z0-9_\-]{20,}\b")),
    ("Anthropic API key", re.compile(r"\bsk-ant-[A-Za-z0-9\-_]{20,}\b")),
    ("GitHub token", re.compile(r"\bgh[pousr]_[A-Za-z0-9]{20,}\b")),
    ("GitHub fine-grained PAT", re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}\b")),
    ("AWS access key id", re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("AWS temporary access key id", re.compile(r"\bASIA[0-9A-Z]{16}\b")),
    ("Slack token", re.compile(r"\bxox[bpare]-[A-Za-z0-9\-]{10,}\b")),
    ("GitLab personal access token", re.compile(r"\bglpat-[A-Za-z0-9\-_]{15,}\b")),
    ("Hugging Face token", re.compile(r"\bhf_[A-Za-z0-9]{20,}\b")),
    ("Stripe key", re.compile(r"\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{10,}\b")),
    ("PEM private key", re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----")),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z_\-]{35}\b")),
    ("JWT", re.compile(r"\beyJ[A-Za-z0-9_\-]{8,}\.[A-Za-z0-9_\-]+")),
    ("database connection string",
     re.compile(r"://[^/@\s:]+:[^/@\s]+@")),
    ("long base64 credential blob",
     re.compile(r"\b[A-Za-z0-9+/]{32,}={1,2}")),
]
# Credential-shaped assignments: `password = hunter2`. The leading
# lookbehind (not \b) catches the canonical paste shapes `db_password=`
# and `AWS_SECRET_ACCESS_KEY = ...` -- `_` is a word char, so \b fails
# there -- while `passwords = x` still doesn't match (the char after the
# keyword must be `:` or `=`). Requires an explicit = or : so prose like
# "reset your password regularly" does not fire; the value must be >= 8
# chars and is not a placeholder sentinel (none, null, your-key-here, ...)
# so docs discussion doesn't train operators to bypass.
_ASSIGNMENT_RE = re.compile(
    r"(?<![A-Za-z0-9])(password|passwd|pwd|api[_-]?key|secret|secret[_-]?key|"
    r"access[_-]?key|token|client[_-]?secret|access[_-]?token|"
    r"auth[_-]?token|private[_-]?key)\s*[:=]\s*['\"]?(\S{8,})['\"]?",
    re.IGNORECASE,
)
_ASSIGNMENT_DENYLIST = frozenset({
    "none", "null", "nil", "required", "changeme", "change-me", "change_me",
    "your-key-here", "your-api-key", "yourkeyhere", "example", "todo",
    "xxx", "xxxx", "placeholder", "redacted",
})
_BEARER_RE = re.compile(r"\b[Bb]earer\s+([A-Za-z0-9\-._~+/]{10,}={0,2})")
# Placeholder name charset (see the smuggling note above): the proxy only
# swaps registered names; anything outside this charset is not a placeholder
# and stays in the scanned text.
_HSURR_NAME_RE = re.compile(r"hsurr:([A-Za-z0-9_.\-]{1,64})")


def _strip_hsurr_placeholders(text):
    # The sanctioned carrier: a prompt saying `api_key: hsurr:stripe-prod`
    # hands the agent a lookup name, not a value. Scrub placeholders before
    # scanning so placeholder-only text never trips a pattern.
    return _HSURR_NAME_RE.sub("", text)


def _bearer_looks_real(token):
    # "Bearer capability tokens are issued per session" must not fire:
    # demand length or a digit, the way real bearer tokens look.
    return len(token) >= 20 or (len(token) >= 12 and any(c.isdigit() for c in token))


def scan_for_secrets(text):
    """Scan text for secret-shaped values.

    Returns a sorted list of (label, count) for each pattern that matched,
    or []. Labels never contain the matched secret text, so callers can
    display them without becoming a leak channel themselves.
    """
    findings = {}
    text = text or ""
    scrubbed = _strip_hsurr_placeholders(text)
    for label, rx in _SECRET_PATTERNS:
        n = len(rx.findall(scrubbed))
        if n:
            findings[label] = findings.get(label, 0) + n
    for m in _ASSIGNMENT_RE.finditer(scrubbed):
        value = m.group(2).strip("'\"").lower()
        if value in _ASSIGNMENT_DENYLIST:
            continue
        findings["credential assignment"] = \
            findings.get("credential assignment", 0) + 1
    for m in _BEARER_RE.finditer(scrubbed):
        if not _bearer_looks_real(m.group(1)):
            continue
        findings["bearer token"] = findings.get("bearer token", 0) + 1
    # The placeholder names themselves: hsurr:sk-<key> is a smuggled secret,
    # not a lookup -- it would land verbatim in the TUI. Any secret-shaped
    # name is a finding in its own right.
    for name in _HSURR_NAME_RE.findall(text):
        if any(rx.search(name) for _, rx in _SECRET_PATTERNS):
            findings["secret-shaped credential placeholder"] = \
                findings.get("secret-shaped credential placeholder", 0) + 1
    return sorted(findings.items())


def require_no_secrets(text, what, allow=False):
    """Enforce the issue-#9 secret-hygiene property on a funnel text.

    Refuses (RuntimeError) when scan_for_secrets finds anything and the
    operator did not pass --allow-secrets. The refusal names the matched
    pattern kinds -- never the secret values -- and points at the
    hsurr:<name> placeholder discipline. On the explicit-override path the
    finding is announced on stderr (stdout must stay a single JSON document)
    so an accidental --allow-secrets is visible, not silent.
    """
    findings = scan_for_secrets(text)
    if not findings:
        return findings
    detail = ", ".join(
        f"{label} x{n}" if n > 1 else label for label, n in findings)
    if not allow:
        raise RuntimeError(
            f"{what} looks like it carries suspected secrets: {detail}. "
            "Real credentials typed into the job funnel land in the agent's "
            "session store, same-user readable with zero friction. Replace "
            "values with hsurr:<name> placeholders (swapped at the proxy for "
            "allowlisted hosts), or re-run with --allow-secrets to confirm "
            "you intend to hand this to the agent.")
    print(f"muse-job: warning: {what} carries suspected secrets ({detail}); "
          f"proceeding because --allow-secrets was given", file=sys.stderr)
    return findings


