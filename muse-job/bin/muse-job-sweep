#!/usr/bin/env python3
"""muse-job disk sweeper: keep spark-vm's disk healthy.

Watermarks (on /home/ntindle):
  >= 85%  prune closed job dirs older than 7 days, hook events and session
          records older than 30 days
  >= 93%  additionally CLOSE the largest active job(s) (muse-job close:
          removes the worktree, which is where the bytes are) until disk is
          back under 93% or no active jobs remain -- user-approved emergency
          breaker (2026-09-17). `kill` is NOT used here: it only ends the
          tmux session and frees ~0 bytes.

Prints a JSON summary of what it did. Exits 0 always (never break the cron).
"""
import json
import os
import shutil
import subprocess
import time

HOME = os.path.expanduser("~")
JOBS = os.path.join(HOME, "muse-jobs")
EVENTS = os.path.join(HOME, ".local", "share", "muse-job", "events")
SESSIONS = os.path.join(HOME, ".local", "share", "muse-job", "sessions")
WARN_PCT = 85
KILL_PCT = 93
PRUNE_CLOSED_AFTER_DAYS = 7
PRUNE_EVENTS_AFTER_DAYS = 30
# Emergency breaker: close at most this many jobs per run even if disk stays
# high, so one run can't nuke everything (cron re-runs and continues).
MAX_EMERGENCY_CLOSES = 3

summary = {"disk_pct": None, "pruned": [], "closed": [], "freed_hint": None}


def sh(*args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=60)
    except Exception:
        return None


def disk_pct(path):
    try:
        u = shutil.disk_usage(path)
        return round(u.used / u.total * 100, 1)
    except Exception:
        return None


def dir_size(p):
    total = 0
    for dp, _, fns in os.walk(p):
        for fn in fns:
            try:
                total += os.path.getsize(os.path.join(dp, fn))
            except OSError:
                pass
    return total


def active_session_uuids():
    """Session uuids of non-closed jobs -- their hook event files and
    session registrations must never be pruned (issue #3 review: a job
    alive >30 days would otherwise lose its events and false-positive
    the `events-missing` liveness signal)."""
    uuids = set()
    if not os.path.isdir(JOBS):
        return uuids
    for slug in os.listdir(JOBS):
        jf = os.path.join(JOBS, slug, "job.json")
        try:
            with open(jf) as f:
                d = json.load(f)
            sid = d.get("session_uuid")
            # Issue #23 H1: a planted non-string session_uuid (dict/list)
            # used to raise TypeError in the set comprehension below and
            # kill the entire sweep run (not per-job contained) -- a
            # disk-guardian DoS. Filter to non-empty strings.
            if (d.get("state") in ("active", "blocked")
                    and isinstance(sid, str) and sid):
                uuids.add(sid)
        except Exception:
            continue
    return uuids


def prune_old(path, older_than_s, skip_names=()):
    now = time.time()
    for name in os.listdir(path):
        if name in skip_names:
            continue
        p = os.path.join(path, name)
        try:
            if now - os.path.getmtime(p) > older_than_s:
                if os.path.isdir(p) and not os.path.islink(p):
                    shutil.rmtree(p, ignore_errors=True)
                else:
                    os.remove(p)
                summary["pruned"].append(p)
        except OSError:
            pass


def main():
    before = disk_pct(HOME)
    summary["disk_pct"] = before
    if before is None:
        print(json.dumps(summary))
        return
    if before >= WARN_PCT:
        # prune closed jobs
        if os.path.isdir(JOBS):
            for slug in os.listdir(JOBS):
                jd = os.path.join(JOBS, slug)
                jf = os.path.join(jd, "job.json")
                try:
                    with open(jf) as f:
                        state = json.load(f).get("state")
                except Exception:
                    continue
                if state == "closed" and (
                        time.time() - os.path.getmtime(jd)
                        > PRUNE_CLOSED_AFTER_DAYS * 86400):
                    shutil.rmtree(jd, ignore_errors=True)
                    summary["pruned"].append(jd)
        for d in (EVENTS, SESSIONS):
            if os.path.isdir(d):
                # Never prune a live job's event file or session
                # registration, whatever their mtime (issue #3 review).
                skip = {u + ext for u in active_session_uuids()
                        for ext in (".jsonl", ".json")}
                prune_old(d, PRUNE_EVENTS_AFTER_DAYS * 86400, skip)
    # Emergency breaker: close (not kill -- kill only ends the tmux session
    # and frees ~0 bytes) the largest active job(s) until disk is back under
    # KILL_PCT, no active jobs remain, or the per-run cap is hit.
    while True:
        pct = disk_pct(HOME)
        if pct is None or pct < KILL_PCT:
            break
        if len(summary["closed"]) >= MAX_EMERGENCY_CLOSES:
            break
        biggest, biggest_size = None, 0
        if os.path.isdir(JOBS):
            for slug in os.listdir(JOBS):
                jd = os.path.join(JOBS, slug)
                jf = os.path.join(jd, "job.json")
                try:
                    with open(jf) as f:
                        if json.load(f).get("state") == "closed":
                            continue
                except Exception:
                    continue
                s = dir_size(jd)
                if s > biggest_size:
                    biggest, biggest_size = slug, s
        if not biggest:
            break
        r = sh(os.path.join(HOME, "bin", "muse-job"), "close", biggest)
        summary["closed"].append({"slug": biggest,
                                  "bytes": biggest_size,
                                  "rc": r.returncode if r else -1})
    summary["disk_pct_after"] = disk_pct(HOME)
    print(json.dumps(summary))


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        summary["error"] = str(e)[:200]
        print(json.dumps(summary))
