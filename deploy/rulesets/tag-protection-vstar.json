{
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/tags/v*"
      ]
    }
  },
  "enforcement": "active",
  "name": "release-tag-protection",
  "rules": [
    {
      "type": "update"
    },
    {
      "type": "deletion"
    },
    {
      "parameters": {
        "operator": "starts_with",
        "pattern": "v*"
      },
      "type": "tag_name_pattern"
    }
  ],
  "target": "tag"
}
