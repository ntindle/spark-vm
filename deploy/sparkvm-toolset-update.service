[Unit]
Description=spark-vm toolset-update: keep the box's default toolset current (#532)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root: the updater repairs /etc/apt/apt.conf.d (unattended-upgrades
# config) and manages system services. This is the box's own scheduled root
# maintenance, not a privilege granted to anyone new — same trust as a manual
# `sudo apt` run by the operator. Package-manager calls: a one-time
# `apt-get install -y unattended-upgrades` bootstrap (missing package only;
# unattended-upgrades performs installs on its own schedule) plus the weekly
# `apt-get install --only-upgrade` on the allowlisted, already-installed
# toolset packages (docker, node, gh — never a bare system upgrade). The
# weekly converge can trigger maintainer-script service restarts (e.g.
# dockerd); those run only behind the idle gate (defer while agent jobs are
# live) in the weekly quiet-hours window.
#
# CRITICAL: ExecStart points at the INSTALLED COPY in
# /home/ntindle/.sparkvm-toolset/bin/ — never at the repo checkout. A writer
# with checkout access must not be able to rewire the updater's own code;
# refreshing the installed copy is the privileged `install` step
# (see docs/TOOLSET_UPDATE.md).
User=root
ExecStart=/home/ntindle/.sparkvm-toolset/bin/toolset-update.sh update
# Harden the root service: no privilege escalation from the updater itself.
# No PrivateTmp: the idle gate must observe the real /tmp to see per-uid
# tmux sockets (/tmp/tmux-<uid>/); a private /tmp would blind the tmux half
# of the gate under the timer. Staged files stay invisible to other users
# by mode instead (mktemp -d is 0700, umask 077).
NoNewPrivileges=true
# A failed run must be loud in the journal and in the state dir.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
