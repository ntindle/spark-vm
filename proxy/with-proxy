#!/bin/bash
# with-proxy — run a command with traffic routed through the local
# credential-swapping proxy (127.0.0.1:18080).
#
# Configs passed to the command may contain hsurr:<name> placeholders;
# the proxy swaps them for real secrets, for allowlisted hosts only.
# Opt-in per command: nothing here changes the global environment.
set -u
# Host edition. The swapd CA is NOT in the host's system store (owner
# decision 13: system-wide trust inside the jail only), so this points at
# a dedicated bundle = system CAs + swapd CA cert, built by deploy.sh.
# Git reads GIT_SSL_CAINFO, not SSL_CERT_FILE, hence the extra export.
# A caller-inherited NO_PROXY/no_proxy would silently bypass this proxy:
# placeholders would go out unswapped and unaudited. Clear both so the
# wrapper's behavior is always what it advertises.
unset NO_PROXY no_proxy
CA_BUNDLE=/usr/local/share/with-proxy-ca/ca-bundle.crt
if [ ! -f "$CA_BUNDLE" ]; then
    echo "with-proxy: CA bundle missing: $CA_BUNDLE (deploy.sh builds it; run it first)" >&2
    exit 1
fi
export http_proxy=http://127.0.0.1:18080
export https_proxy=http://127.0.0.1:18080
export HTTP_PROXY=http://127.0.0.1:18080
export HTTPS_PROXY=http://127.0.0.1:18080
export REQUESTS_CA="$CA_BUNDLE"
export REQUESTS_CA_BUNDLE="$CA_BUNDLE"
export CURL_CA_BUNDLE="$CA_BUNDLE"
export SSL_CERT_FILE="$CA_BUNDLE"
export GIT_SSL_CAINFO="$CA_BUNDLE"
export NODE_EXTRA_CA_CERTS="$CA_BUNDLE"
if [ "$#" -eq 0 ]; then
    echo "usage: with-proxy <cmd> [args...]" >&2
    exit 2
fi
exec "$@"
