#!/bin/bash
# cred-registry-set — narrow writer for the swapd credential registry.
# Invoked as swapd via sudo:
#   cred-registry-set set <name> <entry> <placement-json>
#   cred-registry-set remove <name> [entry]
#   cred-registry-set add-host <name> <host>
#   cred-registry-set remove-host <name> <host>
#   cred-registry-set add-method <name> <METHOD>     (grant scoping)
#   cred-registry-set remove-method <name> <METHOD>
#   cred-registry-set clear-method-limit <name>   (back to unrestricted)
#   cred-registry-set add-path <name> <prefix>       (grant scoping)
#   cred-registry-set remove-path <name> <prefix>
#   cred-registry-set clear-path-limit <name>        (back to unrestricted)
#   cred-registry-set set-scrub <name> <entry> <true|false>  (finding 36)
# Merges into /home/swapd/credentials.json atomically (0600, swapd-owned)
# under an exclusive flock on a dedicated lock file, so concurrent
# invocations cannot lose each other's updates.
# Root-owned 0755; ntindle can only execute it via the sudoers entry.
set -euo pipefail

exec python3 - "$@" <<'PYEOF'
import fcntl, json, os, re, sys, tempfile
import atexit

def fail(msg):
    sys.stderr.write("cred-registry-set: %s\n" % msg)
    sys.exit(1)

args = sys.argv[1:]
ACTIONS = ("set", "remove", "add-host", "remove-host",
           "add-method", "remove-method", "clear-method-limit",
           "add-path", "remove-path", "clear-path-limit",
           "set-scrub")
if not args or args[0] not in ACTIONS:
    fail("usage: set <name> <entry> <placement-json> | remove <name> [entry] "
         "| add-host <name> <host> | remove-host <name> <host> "
         "| add-method <name> <METHOD> | remove-method <name> <METHOD> "
         "| clear-method-limit <name> "
         "| add-path <name> <prefix> | remove-path <name> <prefix> "
         "| clear-path-limit <name> "
         "| set-scrub <name> <entry> <true|false>")
action = args[0]

def check(s, what):
    # Canonical contract shared with the `cred` CLI and cred-ui (#150):
    # credential/entry names are [A-Za-z0-9_-], 1-64 chars. This strict form
    # gates CREATION (the `set` verb). Pure-management verbs use
    # check_legacy/check_entry_legacy below so credentials created before
    # the cap stay manageable without hand-editing the registry as root.
    if not re.match(r"^[A-Za-z0-9_-]{1,64}$", s or ""):
        fail("invalid %s %r (use only [A-Za-z0-9_-], max 64 chars)" % (what, s))

def check_legacy(s, what):
    # Legacy-tolerant name check for management verbs (remove, add-host,
    # remove-host, method/path limit verbs, set-scrub): charset-only, no
    # length cap. No new hole: on these paths the name is only ever a dict
    # key and print output — this script runs as `python3 - "$@"`, argv
    # only, no shell — and entries keep the RESERVED_ENTRIES guard via
    # check_entry_legacy (finding 34b).
    if not re.match(r"^[A-Za-z0-9_-]+$", s or ""):
        fail("invalid %s %r (use only [A-Za-z0-9_-])" % (what, s))

HOST_MAX_LEN = 253
HOST_LABEL_MAX_LEN = 63

def check_host(h):
    # Canonical contract shared with the `cred` CLI's check_host() and
    # cred-ui's host_ok() (#150): dotted-hostname shape, total length
    # <= HOST_MAX_LEN, each dot-separated label <= HOST_LABEL_MAX_LEN.
    lowered = (h or "").lower()
    if (len(lowered) > HOST_MAX_LEN
            or not re.match(r"^\.?[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*$", lowered)
            or any(len(label) > HOST_LABEL_MAX_LEN
                   for label in lowered.lstrip(".").split("."))):
        fail("invalid host %r" % (h,))
    return lowered

def check_host_legacy(h):
    # Shape-only host check for remove-host: an over-long legacy host
    # binding must stay removable. New bindings (add-host) always go
    # through the canonical check_host above.
    lowered = (h or "").lower()
    if not re.match(r"^\.?[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*$", lowered):
        fail("invalid host %r" % (h,))
    return lowered

reg_path = os.environ.get("CRED_REGISTRY_FILE",
                           "/home/swapd/credentials.json")
reg_dir = os.path.dirname(reg_path) or "."

# All read-modify-write cycles run under an exclusive flock on a
# dedicated lock file (never replaced), so two concurrent invocations
# cannot interleave into lost updates. Released via atexit so fail()
# (sys.exit) still unlocks.
reg_lock_path = os.environ.get("CRED_REGISTRY_LOCK", reg_path + ".lock")
_lock_fd = os.open(reg_lock_path, os.O_RDWR | os.O_CREAT, 0o600)
fcntl.flock(_lock_fd, fcntl.LOCK_EX)
def _unlock():
    try:
        fcntl.flock(_lock_fd, fcntl.LOCK_UN)
    finally:
        os.close(_lock_fd)
atexit.register(_unlock)

reg = {}
if os.path.exists(reg_path):
    with open(reg_path, encoding="utf-8") as f:
        reg = json.load(f)
    if not isinstance(reg, dict):
        fail("registry is not a JSON object")

# Structural keys must never become credential entries: an entry named
# "allowed_hosts" would clobber the host binding with a placement object
# (finding 34b). allowed_methods/allowed_paths are reserved for the
# grant-scoping proposal, and grants is reserved before the deferred
# grant machinery lands (finding 44).
RESERVED_ENTRIES = ("allowed_hosts", "allowed_methods", "allowed_paths",
                    "grants")

def check_entry(s):
    check(s, "entry")
    if s in RESERVED_ENTRIES:
        fail("entry name %r is reserved" % (s,))

def check_entry_legacy(s):
    # Legacy-tolerant entry check for management verbs (remove, set-scrub):
    # charset-only like check_legacy, but the RESERVED_ENTRIES guard stays —
    # an entry named "allowed_hosts" would clobber the host binding
    # (finding 34b), legacy or not.
    check_legacy(s, "entry")
    if s in RESERVED_ENTRIES:
        fail("entry name %r is reserved" % (s,))

def save():
    # Crash-durable: mkstemp in the same directory (0600), fsync the
    # file, rename atomically, fsync the directory.
    fd, tmp = tempfile.mkstemp(dir=reg_dir, prefix=".tmp.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(reg, f, indent=2, sort_keys=True)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, reg_path)
        dfd = os.open(reg_dir, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

if action == "set":
    if len(args) != 4:
        fail("usage: cred-registry-set set <name> <entry> <placement-json>")
    _, name, entry, pjson = args
    check(name, "name")
    check_entry(entry)
    try:
        placement = json.loads(pjson)
    except ValueError:
        fail("placement is not valid JSON")
    ok = (
        placement in ("bearer_header", "url_path_segment")
        or (
            isinstance(placement, dict)
            and len(placement) == 1
            and list(placement)[0] in ("custom_header", "query_param", "url_path_segment")
            and isinstance(list(placement.values())[0], str)
            and re.match(r"^[A-Za-z0-9_.-]{1,64}$", list(placement.values())[0])
        )
    )
    if not ok:
        fail("invalid placement %r" % (placement,))
    reg.setdefault(name, {})[entry] = {"placement": placement}
    save()
    print("registered '%s' entry '%s'" % (name, entry))
elif action == "remove":
    if len(args) not in (2, 3):
        fail("usage: cred-registry-set remove <name> [entry]")
    name = args[1]
    check_legacy(name, "name")
    if name not in reg:
        fail("credential '%s' not registered" % (name,))
    if len(args) == 3:
        entry = args[2]
        check_entry_legacy(entry)
        reg[name].pop(entry, None)
        if not reg[name]:
            del reg[name]
        print("unregistered '%s' entry '%s'" % (name, entry))
    else:
        del reg[name]
        print("unregistered '%s'" % (name,))
    save()
elif action in ("add-host", "remove-host"):
    if len(args) != 3:
        fail("usage: cred-registry-set %s <name> <host>" % action)
    name = args[1]
    check_legacy(name, "name")
    # New bindings must satisfy the canonical contract; removing a legacy
    # over-long binding must stay possible.
    host = (check_host(args[2]) if action == "add-host"
            else check_host_legacy(args[2]))
    entry = reg.setdefault(name, {})
    if not isinstance(entry, dict):
        fail("registry entry for '%s' is not an object" % (name,))
    hosts = entry.setdefault("allowed_hosts", [])
    if not isinstance(hosts, list):
        fail("allowed_hosts for '%s' is not a list" % (name,))
    if action == "add-host":
        if host not in hosts:
            hosts.append(host)
        print("bound '%s' to host '%s'" % (name, host))
    else:
        if host in hosts:
            hosts.remove(host)
        print("unbound '%s' from host '%s'" % (name, host))
    save()
elif action in ("add-method", "remove-method"):
    # Grant scoping, approved half: static per-credential method limits.
    # Stored uppercased; the addon uppercases the request method too.
    if len(args) != 3:
        fail("usage: cred-registry-set %s <name> <METHOD>" % action)
    name, method = args[1], args[2]
    check_legacy(name, "name")
    if not re.match(r"^[A-Za-z]+$", method or ""):
        fail("invalid method %r" % (method,))
    method = method.upper()
    entry = reg.setdefault(name, {})
    if not isinstance(entry, dict):
        fail("registry entry for '%s' is not an object" % (name,))
    methods = entry.setdefault("allowed_methods", [])
    if not isinstance(methods, list):
        fail("allowed_methods for '%s' is not a list" % (name,))
    if action == "add-method":
        if method not in methods:
            methods.append(method)
        print("limited '%s' to method '%s'" % (name, method))
    else:
        if method in methods:
            methods.remove(method)
        if not methods:
            # An emptied list is deny-all (the addon refuses every swap
            # when allowed_methods is present but empty), NOT
            # unrestricted. Use clear-method-limit to deliberately
            # return to unrestricted.
            print("removed method '%s' from '%s'; now deny-all (no methods allowed)"
                  % (method, name))
        else:
            print("removed method '%s' from '%s'" % (method, name))
    save()
elif action == "clear-method-limit":
    if len(args) != 2:
        fail("usage: cred-registry-set clear-method-limit <name>")
    name = args[1]
    check_legacy(name, "name")
    entry = reg.get(name)
    if not isinstance(entry, dict):
        fail("no such credential '%s'" % (name,))
    entry.pop("allowed_methods", None)
    print("cleared method limit for '%s'; now unrestricted" % (name,))
    save()
elif action in ("add-path", "remove-path"):
    # Grant scoping, approved half: static per-credential path prefixes.
    # The addon percent-decodes, dot-segment-normalizes, and
    # segment-aligns these before matching.
    if len(args) != 3:
        fail("usage: cred-registry-set %s <name> <prefix>" % action)
    name, prefix = args[1], args[2]
    check_legacy(name, "name")
    if not prefix.startswith("/") or re.search(r"\s", prefix):
        fail("invalid path prefix %r (must start with /, no whitespace)"
             % (prefix,))
    entry = reg.setdefault(name, {})
    if not isinstance(entry, dict):
        fail("registry entry for '%s' is not an object" % (name,))
    prefixes = entry.setdefault("allowed_paths", [])
    if not isinstance(prefixes, list):
        fail("allowed_paths for '%s' is not a list" % (name,))
    if action == "add-path":
        if prefix not in prefixes:
            prefixes.append(prefix)
        print("limited '%s' to path prefix '%s'" % (name, prefix))
    else:
        if prefix in prefixes:
            prefixes.remove(prefix)
        if not prefixes:
            # An emptied list is deny-all (the addon refuses every swap
            # when allowed_paths is present but empty), NOT
            # unrestricted. Use clear-path-limit to deliberately return
            # to unrestricted.
            print("removed path prefix '%s' from '%s'; now deny-all (no paths allowed)"
                  % (prefix, name))
        else:
            print("removed path prefix '%s' from '%s'" % (prefix, name))
    save()
elif action == "clear-path-limit":
    if len(args) != 2:
        fail("usage: cred-registry-set clear-path-limit <name>")
    name = args[1]
    check_legacy(name, "name")
    entry = reg.get(name)
    if not isinstance(entry, dict):
        fail("no such credential '%s'" % (name,))
    entry.pop("allowed_paths", None)
    print("cleared path limit for '%s'; now unrestricted" % (name,))
    save()
elif action == "set-scrub":
    # Finding 36: opt an entry (usernames, emails) out of response
    # scrubbing entirely.
    if len(args) != 4 or args[3] not in ("true", "false"):
        fail("usage: cred-registry-set set-scrub <name> <entry> <true|false>")
    _, name, entry, flag = args
    check_legacy(name, "name")
    check_entry_legacy(entry)
    entry_spec = reg.setdefault(name, {}).setdefault(entry, {})
    if not isinstance(entry_spec, dict):
        fail("entry '%s' for '%s' is not an object" % (entry, name))
    entry_spec["scrub"] = (flag == "true")
    save()
    print("set scrub=%s for '%s' entry '%s'" % (flag, name, entry))
PYEOF
