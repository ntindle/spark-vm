[Unit]
Description=Transparent credential-swapping egress proxy (mitmdump, as swapd)
After=network-online.target
Wants=network-online.target

[Service]
User=swapd
# dumper_filter matches nothing: mitmdump's per-flow request/response lines
# print full URLs, which may contain swapped secrets in query params.
# The addon's own audit log (swap.log) is the intended observability.
ExecStart=/home/swapd/.venvs/mitm/bin/mitmdump -p 18080 --set listen_host=127.0.0.1 -s /home/swapd/swap_addon.py --set termlog_verbosity=warn --set "dumper_filter=~d nomatch.invalid"
# Issue #1609: the path-jail pre-check. Importing the addon runs the
# module-level SwapAddon() construction, tripping _validate_path_jail()
# as its first statement; a violation raises RuntimeError, the import
# exits nonzero, and the service never starts (fail closed — mitmproxy's
# script loader would otherwise swallow the exception and serve
# addon-less, with no swaps, no SSRF guard, and no audit at all).
ExecStartPre=/home/swapd/.venvs/mitm/bin/python3 -c "import sys; sys.path.insert(0, '/home/swapd'); import swap_addon"
Restart=always
RestartSec=5
# Issue #95: systemd hardening (mirrors cred-ui's #115 shape, extended).
# What this process needs: the mitm venv + addon under /home/swapd, and
# its runtime paths (secrets dir, hosts.allow, registry, audit log,
# approvals/grants — all _env_path defaults under /home/swapd, verified
# against proxy/swap_addon.py), plus the stdlib. Deploy order note: /home/swapd
# must exist before the unit starts (a missing ReadWritePaths dir fails
# service startup; it is not auto-created). Contract (issue #709): keep
# every SWAP_*_DIR/_FILE override under SWAP_BASE_DIR (default
# /home/swapd). The unit sandboxes with ProtectSystem=strict +
# ReadWritePaths=/home/swapd + PrivateTmp=yes, so: writes outside
# /home/swapd fail at the first write (EROFS) — except in the
# service-private /tmp and /var/tmp, which are writable but ephemeral;
# reads outside /home/swapd still succeed (strict is read-only, not
# inaccessible), so a mispointed hosts/registry/SSRF path would silently
# read from outside the jail. Two-layer enforcement (issue #1609):
# ExecStartPre below imports the addon — tripping its startup path
# jail — before the service starts, so a violation fails the pre-check
# and the service never serves (Restart=always loops loudly in the
# journal). The in-addon gate is defense-in-depth for direct
# `mitmdump -s` invocations, because mitmproxy's script loader would
# otherwise swallow the exception and keep serving addon-less.
#
# NoNewPrivileges IS set here (unlike cred-ui's #115 unit): the addon never
# escalates — no sudo, no setuid helpers, no subprocesses at all
# (grep-verified) — so locking out privilege acquisition costs nothing.
# The kernel trio is set because these are system units (installed to
# /etc/systemd/system/ by proxy/deploy.sh); cred-ui's user unit cannot use
# them (systemd documents them as system-unit-only).
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/swapd
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
