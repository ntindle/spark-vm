[Unit]
Description=Inference-only credential-swapping proxy (mitmdump, as swapd)
After=network-online.target
Wants=network-online.target

[Service]
User=swapd
# Finding 31: obox's LLM calls go through this separate mitmdump
# instance, not the main swap proxy. It has its own secrets dir holding
# ONLY the provider API key, its own hosts file holding ONLY the
# provider, its own registry, its own audit log, and its own SSRF allow
# file. The provider must never appear in the main proxy's hosts.allow,
# and the inference SSRF allow file must never be the main proxy's
# shared one (the deny file is the deliberate exception: SWAP_SSRF_DENY_FILE
# is not overridden here, so both units read /home/swapd/ssrf.deny):
# the gate fixture (harness/install-gate-fixture.sh) needs a loopback
# exemption for its echo origin, and that exemption must never weaken
# the main proxy's finding-29 egress guard.
Environment=SWAP_SECRETS_DIR=/home/swapd/inference-secrets
Environment=SWAP_HOSTS_FILE=/home/swapd/inference-hosts.allow
Environment=SWAP_REGISTRY_FILE=/home/swapd/inference-registry.json
Environment=SWAP_LOG_FILE=/home/swapd/inference-swap.log
Environment=SWAP_SSRF_FILE=/home/swapd/inference-ssrf.allow
Environment=SWAP_INFERENCE_MODE=1
# Finding 60: the inference proxy has no approvals directory. It reads
# grants.json but never files approvals or consumes answers.
Environment=SWAP_ENABLE_APPROVALS=0
ExecStart=/home/swapd/.venvs/mitm/bin/mitmdump -p 18081 --set listen_host=127.0.0.1 -s /home/swapd/swap_addon.py --set termlog_verbosity=warn --set "dumper_filter=~d nomatch.invalid"
Restart=always
RestartSec=5
# Issue #95: systemd hardening (mirrors cred-ui's #115 shape, extended).
# What this process needs: the mitm venv + addon under /home/swapd, and
# its runtime paths (SWAP_*_DIR/FILE values — defaults or Environment=
# overrides, all under /home/swapd, verified against proxy/swap_addon.py),
# plus the stdlib. Deploy order note: /home/swapd must exist before the
# unit starts (a missing ReadWritePaths dir fails service startup; it is
# not auto-created). Contract (issue #709): keep every SWAP_*_DIR/_FILE
# override under /home/swapd — _env_path does NOT validate this. The
# unit sandboxes with ProtectSystem=strict + ReadWritePaths=/home/swapd
# + PrivateTmp=yes, so: writes outside /home/swapd fail at the first
# write (EROFS) — except in the service-private /tmp and /var/tmp,
# which are writable but ephemeral; reads outside /home/swapd still
# succeed (strict is read-only, not inaccessible), so a mispointed
# hosts/registry/SSRF path silently reads from outside the jail.
# Nothing at deploy checks these — the failure (or silent misread)
# happens at runtime.
#
# NoNewPrivileges IS set here (unlike cred-ui's #115 unit): the addon never
# escalates — no sudo, no setuid helpers, no subprocesses at all
# (grep-verified) — so locking out privilege acquisition costs nothing.
# The kernel trio is set because these are system units (installed to
# /etc/systemd/system/ by proxy/deploy.sh); cred-ui's user unit cannot use
# them (systemd documents them as system-unit-only).
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/swapd
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
