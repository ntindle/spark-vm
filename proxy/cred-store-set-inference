#!/bin/bash
# cred-store-set-inference — narrow writer for the inference proxy's secret
# store. Invoked as: sudo -u swapd /usr/local/bin/cred-store-set-inference
# Reads the provider API key from stdin (piped, never a visible prompt —
# finding 46), writes it atomically to <dir>/llm-api (0600, swapd-owned).
# The name is fixed: the inference proxy (finding 31) holds exactly one
# credential. INFERENCE_SECRETS_DIR overrides the directory for tests;
# production always uses the fixed default below.
# Root-owned 0755; ntindle cannot modify this script, only execute it
# via the sudoers entry.
set -euo pipefail
umask 077

dir="${INFERENCE_SECRETS_DIR:-/home/swapd/inference-secrets}"
max_bytes=65536

tmp="$(mktemp "$dir/.tmp.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
chmod 600 "$tmp"

# Read stdin capped at max_bytes+1 so an oversized value is detectable.
# head exits 0 even when the input is shorter.
head -c $((max_bytes + 1)) > "$tmp"
size="$(wc -c < "$tmp")"
if [ "$size" -eq 0 ]; then
    echo "cred-store-set-inference: refusing to store an empty secret" >&2
    exit 2
fi
if [ "$size" -gt "$max_bytes" ]; then
    echo "cred-store-set-inference: secret exceeds 64 KiB" >&2
    exit 2
fi

# Crash-durable: fsync the file, rename atomically, fsync the directory.
python3 - "$tmp" <<'PYEOF'
import os, sys
fd = os.open(sys.argv[1], os.O_RDWR)
try:
    os.fsync(fd)
finally:
    os.close(fd)
PYEOF
mv -f "$tmp" "$dir/llm-api"
python3 - "$dir" <<'PYEOF'
import os, sys
fd = os.open(sys.argv[1], os.O_RDONLY)
try:
    os.fsync(fd)
finally:
    os.close(fd)
PYEOF
trap - EXIT
echo "stored inference credential 'llm-api'"
