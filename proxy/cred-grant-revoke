#!/usr/bin/env python3
"""cred-grant-revoke — revoke grants for a job (owner decision, round 5).

bdrive calls this at job end over the peer-checked socket (future);
for now it's a CLI that swapd (or root) runs.

Usage: cred-grant-revoke --job <job-id>
"""
import argparse
import json
import os
import sys

REGISTRY = os.environ.get("SWAP_REGISTRY_FILE", "/home/swapd/credentials.json")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--job", required=True, help="job id whose grants to revoke")
    args = ap.parse_args()

    try:
        with open(REGISTRY) as f:
            reg = json.load(f)
    except (OSError, ValueError) as e:
        print("cannot read registry: %s" % e, file=sys.stderr)
        return 1

    grants = reg.get("grants")
    if not isinstance(grants, list):
        print("no grants")
        return 0

    kept = [g for g in grants
            if not isinstance(g, dict) or g.get("job") != args.job]
    revoked = len(grants) - len(kept)
    if revoked:
        reg["grants"] = kept
        tmp = REGISTRY + ".tmp"
        with open(tmp, "w") as f:
            json.dump(reg, f, indent=2)
        os.replace(tmp, REGISTRY)
    print("revoked %d grant(s) for job %s" % (revoked, args.job))
    return 0


if __name__ == "__main__":
    sys.exit(main())
