#!/usr/bin/env python3
"""cred — tiny credential store for the spark-vm workhorse box.

Backends:
  file       (default) secrets in ~/.config/spark-credentials/<name>,
             directory 0700, files 0600. Same trust model as ~/.ssh.
  bitwarden  (planned) will shell out to the `bw` CLI. Not implemented yet;
             selecting it raises a clear error.

Usage:
  cred set <name>        read secret from stdin (piped) or a no-echo prompt
  cred get <name>        print secret to stdout (no trailing newline)
  cred list              print stored names, one per line (never values)
  cred delete <name>     remove a stored credential
  cred run -- <cmd> [args...]
                         export every credential as SPARK_CRED_<NAME>
                         (uppercased, '-' -> '_') and exec the command.
                         This is the automatic injection path for scripts.

Missing credential: commands exit 3 with an actionable message telling the
human exactly what to run once; everything downstream then works automatically.
"""

import getpass
import os
import re
import sys

NAME_RE = re.compile(r"^[A-Za-z0-9_-]+$")
BACKEND_ENV = "SPARK_CRED_BACKEND"
DEFAULT_ROOT = os.path.expanduser("~/.config/spark-credentials")
MISSING_MSG = "credential '{name}' not set \u2014 add with: cred set {name}"


# ---------------------------------------------------------------- backends

class CredentialError(Exception):
    """Fatal, user-actionable error. Message is printed to stderr."""


class CredentialNotFound(CredentialError):
    def __init__(self, name):
        super().__init__(MISSING_MSG.format(name=name))
        self.name = name


class Backend:
    """Interface every credential backend must implement."""

    def set(self, name, secret):
        raise NotImplementedError

    def get(self, name):
        raise NotImplementedError

    def list(self):
        raise NotImplementedError

    def delete(self, name):
        raise NotImplementedError

    def all(self):
        """Return {name: secret} for every stored credential."""
        raise NotImplementedError


class FileBackend(Backend):
    """Secrets as 0600 files under a 0700 directory."""

    def __init__(self, root=DEFAULT_ROOT):
        self.root = root

    # -- internals -------------------------------------------------
    def _ensure_root(self):
        os.makedirs(self.root, mode=0o700, exist_ok=True)
        os.chmod(self.root, 0o700)

    def _check_name(self, name):
        if not NAME_RE.match(name or ""):
            raise CredentialError(
                "invalid credential name %r \u2014 use only [A-Za-z0-9_-]" % (name,)
            )
        return name

    def _path(self, name):
        self._check_name(name)
        # join + abspath guard so a name can never escape the root
        p = os.path.abspath(os.path.join(self.root, name))
        if os.path.dirname(p) != os.path.abspath(self.root):
            raise CredentialError("invalid credential name %r" % (name,))
        return p

    # -- interface -------------------------------------------------
    def set(self, name, secret):
        self._ensure_root()
        p = self._path(name)
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(secret)
        os.chmod(p, 0o600)

    def get(self, name):
        p = self._path(name)
        try:
            with open(p, "r", encoding="utf-8") as f:
                return f.read()
        except FileNotFoundError:
            raise CredentialNotFound(name)

    def list(self):
        self._ensure_root()
        try:
            entries = os.listdir(self.root)
        except FileNotFoundError:
            return []
        return sorted(
            e for e in entries
            if NAME_RE.match(e) and os.path.isfile(os.path.join(self.root, e))
        )

    def delete(self, name):
        p = self._path(name)
        try:
            os.unlink(p)
        except FileNotFoundError:
            raise CredentialNotFound(name)

    def all(self):
        return {name: self.get(name) for name in self.list()}


class BitwardenBackend(Backend):
    """Planned backend: secrets via the `bw` CLI. Not implemented yet."""

    def __init__(self):
        raise CredentialError(
            "SPARK_CRED_BACKEND=bitwarden is not implemented yet \u2014 "
            "unset it (or set it to 'file') to use the file backend."
        )


def get_backend():
    """Backend factory. Honours SPARK_CRED_BACKEND (default: file)."""
    kind = os.environ.get(BACKEND_ENV, "file")
    if kind == "file":
        return FileBackend()
    if kind == "bitwarden":
        return BitwardenBackend()
    raise CredentialError(
        "unknown %s %r \u2014 expected 'file' or 'bitwarden'" % (BACKEND_ENV, kind)
    )


# ---------------------------------------------------------------- helpers

def env_name(name):
    """SPARK_CRED_<NAME>: uppercased, '-' becomes '_'."""
    return "SPARK_CRED_" + name.upper().replace("-", "_")


def read_secret_stdin():
    data = sys.stdin.read()
    # chomp one trailing newline (echo adds one); interior content untouched
    if data.endswith("\r\n"):
        data = data[:-2]
    elif data.endswith("\n"):
        data = data[:-1]
    return data


def read_secret_prompt(name):
    first = getpass.getpass("secret for '%s': " % name)
    second = getpass.getpass("confirm: ")
    if first != second:
        raise CredentialError("secrets did not match \u2014 try again")
    if not first:
        raise CredentialError("empty secret \u2014 try again")
    return first


USAGE = """usage: cred <command> [args]

  cred set <name>              store a secret (stdin pipe or no-echo prompt)
  cred get <name>              print a secret to stdout
  cred list                    list stored credential names (never values)
  cred delete <name>           delete a stored credential
  cred run -- <cmd> [args...]  exec cmd with all credentials exported as
                               SPARK_CRED_<NAME> in its environment

backend: SPARK_CRED_BACKEND=file (default) | bitwarden (planned)
"""


# ---------------------------------------------------------------- commands

def cmd_set(backend, args):
    if len(args) != 1:
        raise CredentialError("usage: cred set <name>")
    name = args[0]
    if sys.stdin.isatty():
        secret = read_secret_prompt(name)
    else:
        secret = read_secret_stdin()
    backend.set(name, secret)
    print("stored '%s'" % name)


def cmd_get(backend, args):
    if len(args) != 1:
        raise CredentialError("usage: cred get <name>")
    sys.stdout.write(backend.get(args[0]))


def cmd_list(backend, args):
    if args:
        raise CredentialError("usage: cred list")
    for name in backend.list():
        print(name)


def cmd_delete(backend, args):
    if len(args) != 1:
        raise CredentialError("usage: cred delete <name>")
    backend.delete(args[0])
    print("deleted '%s'" % args[0])


def cmd_run(backend, args):
    if not args or args[0] != "--":
        raise CredentialError("usage: cred run -- <cmd> [args...]")
    argv = args[1:]
    if not argv:
        raise CredentialError("usage: cred run -- <cmd> [args...]")
    env = dict(os.environ)
    for name, secret in backend.all().items():
        env[env_name(name)] = secret
    os.execvpe(argv[0], argv, env)


COMMANDS = {
    "set": cmd_set,
    "get": cmd_get,
    "list": cmd_list,
    "delete": cmd_delete,
    "run": cmd_run,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE)
        return 0
    cmd = COMMANDS.get(argv[0])
    if cmd is None:
        sys.stderr.write(USAGE)
        return 2
    try:
        backend = get_backend()
        cmd(backend, argv[1:])
    except CredentialNotFound as e:
        sys.stderr.write(str(e) + "\n")
        return 3
    except CredentialError as e:
        sys.stderr.write("cred: %s\n" % e)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
