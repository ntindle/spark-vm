#!/usr/bin/env python3
"""cred — secret management front-end for the spark-vm swapping proxy.

Secrets live in /home/swapd/secrets/, owned by the swapd system user.
This CLI reaches that store ONLY through narrow sudo helpers:

  cred set <name>     store a secret (stdin pipe or no-echo prompt)
                      -> sudo -u swapd /usr/local/bin/cred-store-set <name>
  cred get <name>     print a secret to stdout (no trailing newline).
                      For the HUMAN and for local scripts. The agent's
                      standing policy is to never invoke this.
  cred list           list stored credential names (never values)
  cred delete <name>  delete a stored credential
  cred register <name> [--entry <entry>] [--placement <spec>]
                      record a credential's request placement in the registry
  cred unregister <name> [--entry <entry>]
                      remove a credential's registry entry
  cred run -- <cmd> [args...]
                      exec <cmd> with traffic routed through the
                      credential-swapping proxy (127.0.0.1:18080).
                      Configs may carry hsurr:<name> placeholders; the
                      proxy swaps them for real values, allowlisted
                      hosts only. The agent never sees secret values.

Secrets are installed ONLY by the human in their own SSH session:
  cred set <name>     (paste at the prompt; never send it to the agent)

Missing credential: exit 3 with the exact command to fix it.
"""

import getpass
import json
import os
import re
import subprocess
import sys

NAME_RE = re.compile(r"^[A-Za-z0-9_-]+$")
BACKEND_ENV = "SPARK_CRED_BACKEND"
STORE = "/home/swapd/secrets"
SUDO = ["sudo", "-n", "-u", "swapd"]
STORE_SET = "/usr/local/bin/cred-store-set"
MISSING_MSG = "credential '{name}' not set \u2014 add with: cred set {name}"


class CredentialError(Exception):
    """Fatal, user-actionable error. Message is printed to stderr."""


class CredentialNotFound(CredentialError):
    def __init__(self, name):
        super().__init__(MISSING_MSG.format(name=name))
        self.name = name


def check_name(name):
    if not NAME_RE.match(name or ""):
        raise CredentialError(
            "invalid credential name %r \u2014 use only [A-Za-z0-9_-]" % (name,)
        )
    return name


def get_backend_kind():
    kind = os.environ.get(BACKEND_ENV, "file")
    if kind != "file":
        raise CredentialError(
            "only %s=file is supported (the swapd secret store) \u2014 got %r"
            % (BACKEND_ENV, kind)
        )
    return kind


def run_as_swapd(argv, input_bytes=None):
    """Run argv as swapd via the sudoers allowlist. Returns CompletedProcess."""
    try:
        return subprocess.run(
            SUDO + argv, input=input_bytes, capture_output=True, check=False
        )
    except FileNotFoundError:
        raise CredentialError("sudo not available on this box")


def read_secret_stdin():
    data = sys.stdin.read()
    # chomp one trailing newline (echo adds one); interior content untouched
    if data.endswith("\r\n"):
        data = data[:-2]
    elif data.endswith("\n"):
        data = data[:-1]
    return data


def read_secret_prompt(name):
    first = getpass.getpass("secret for '%s': " % name)
    second = getpass.getpass("confirm: ")
    if first != second:
        raise CredentialError("secrets did not match \u2014 try again")
    if not first:
        raise CredentialError("empty secret \u2014 try again")
    return first


USAGE = """usage: cred <command> [args]

  cred set <name>              store a secret (stdin pipe or no-echo prompt)
  cred get <name>              print a secret (human/scripts only; the agent
                               never invokes this)
  cred list                    list stored credential names (never values)
  cred delete <name>           delete a stored credential
  cred register <name> [--entry <entry>] [--placement <spec>]
                               record how a credential is placed into requests
                               (registry; default entry access_token, placement
                               bearer_header). <spec>: bearer_header |
                               custom_header:<Name> | query_param:<name> |
                               url_path_segment
  cred unregister <name> [--entry <entry>]
                               remove a credential's registry entry
  cred run -- <cmd> [args...]  exec cmd with traffic routed through the
                               credential-swapping proxy (placeholders
                               hsurr:<name> are swapped at the proxy)

Secrets live in the swapd-owned store; install them only in your own
SSH session. Missing credential exits 3 with the fix command.
"""


def _strip_dashdash(args):
    """Allow `cred <cmd> -- <name>` so odd names can't be mistaken for flags."""
    if args and args[0] == "--":
        return args[1:]
    return args


def cmd_set(args):
    args = _strip_dashdash(args)
    if len(args) != 1:
        raise CredentialError("usage: cred set <name>")
    name = check_name(args[0])
    if sys.stdin.isatty():
        secret = read_secret_prompt(name)
    else:
        secret = read_secret_stdin()
        if not secret:
            raise CredentialError("empty secret \u2014 try again")
    p = run_as_swapd([STORE_SET, name], input_bytes=secret.encode("utf-8"))
    if p.returncode != 0:
        err = p.stderr.decode("utf-8", "replace").strip()
        raise CredentialError(err or "cred-store-set failed")
    print("stored '%s' (swapd store)" % name)


def cmd_get(args):
    args = _strip_dashdash(args)
    if len(args) != 1:
        raise CredentialError("usage: cred get <name>")
    name = check_name(args[0])
    p = run_as_swapd(["/usr/bin/cat", "%s/%s" % (STORE, name)])
    if p.returncode != 0:
        raise CredentialNotFound(name)
    sys.stdout.buffer.write(p.stdout)


def cmd_list(args):
    if args:
        raise CredentialError("usage: cred list")
    p = run_as_swapd(["/usr/bin/ls", STORE])
    if p.returncode != 0:
        return  # missing/empty store: no output, not an error
    sys.stdout.write(p.stdout.decode("utf-8", "replace"))


def cmd_delete(args):
    args = _strip_dashdash(args)
    if len(args) != 1:
        raise CredentialError("usage: cred delete <name>")
    name = check_name(args[0])
    p = run_as_swapd(["/usr/bin/rm", "%s/%s" % (STORE, name)])
    if p.returncode != 0:
        raise CredentialNotFound(name)
    print("deleted '%s'" % name)


PLACEMENT_USAGE = ("--placement <spec>: bearer_header | url_path_segment | "
                   "custom_header:<Name> | query_param:<name>")


def parse_placement(spec):
    if spec in ("bearer_header", "url_path_segment"):
        return spec
    if ":" in spec:
        kind, _, value = spec.partition(":")
        if kind in ("custom_header", "query_param") and re.match(
                r"^[A-Za-z0-9_.-]+$", value or ""):
            return {kind: value}
    raise CredentialError("invalid placement %r \u2014 " + PLACEMENT_USAGE % (spec,))


def cmd_register(args):
    args = _strip_dashdash(args)
    if not args:
        raise CredentialError(
            "usage: cred register <name> [--entry <entry>] [%s]" % PLACEMENT_USAGE)
    name = check_name(args[0])
    entry = "access_token"
    placement = "bearer_header"
    rest = args[1:]
    i = 0
    while i < len(rest):
        if rest[i] == "--entry" and i + 1 < len(rest):
            entry = check_name(rest[i + 1])
            i += 2
        elif rest[i] == "--placement" and i + 1 < len(rest):
            placement = parse_placement(rest[i + 1])
            i += 2
        else:
            raise CredentialError(
                "usage: cred register <name> [--entry <entry>] [%s]" % PLACEMENT_USAGE)
    p = run_as_swapd(["/usr/local/bin/cred-registry-set", "set",
                      name, entry, json.dumps(placement)])
    if p.returncode != 0:
        err = p.stderr.decode("utf-8", "replace").strip()
        raise CredentialError(err or "cred-registry-set failed")
    sys.stdout.write(p.stdout.decode("utf-8", "replace"))


def cmd_unregister(args):
    args = _strip_dashdash(args)
    if not args:
        raise CredentialError("usage: cred unregister <name> [--entry <entry>]")
    name = check_name(args[0])
    rest = args[1:]
    entry = None
    i = 0
    while i < len(rest):
        if rest[i] == "--entry" and i + 1 < len(rest):
            entry = check_name(rest[i + 1])
            i += 2
        else:
            raise CredentialError("usage: cred unregister <name> [--entry <entry>]")
    cmd = ["/usr/local/bin/cred-registry-set", "remove", name]
    if entry:
        cmd.append(entry)
    p = run_as_swapd(cmd)
    if p.returncode != 0:
        err = p.stderr.decode("utf-8", "replace").strip()
        raise CredentialError(err or "cred-registry-set failed")
    sys.stdout.write(p.stdout.decode("utf-8", "replace"))


def cmd_run(args):
    if not args or args[0] != "--" or len(args) < 2:
        raise CredentialError("usage: cred run -- <cmd> [args...]")
    argv = args[1:]
    os.execvp("/usr/local/bin/with-proxy", ["with-proxy"] + argv)


COMMANDS = {
    "set": cmd_set,
    "get": cmd_get,
    "list": cmd_list,
    "delete": cmd_delete,
    "register": cmd_register,
    "unregister": cmd_unregister,
    "run": cmd_run,
}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE)
        return 0
    cmd = COMMANDS.get(argv[0])
    if cmd is None:
        sys.stderr.write(USAGE)
        return 2
    try:
        get_backend_kind()
        cmd(argv[1:])
    except CredentialNotFound as e:
        sys.stderr.write(str(e) + "\n")
        return 3
    except CredentialError as e:
        sys.stderr.write("cred: %s\n" % e)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
