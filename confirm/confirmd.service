[Unit]
Description=Tailnet-only confirmation page (Tailscale-identity auth)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=swapd
Group=swapd
# Runs as swapd (owner decision 3: "swapd or bdrive serves the page").
# Binds the tailnet address only; every request is authenticated by
# Tailscale identity against CONFIRM_OWNER.
# No CONFIRM_BIND pin here on purpose: confirmd.py resolves the bind address
# at startup via `tailscale ip -4` (finding 53(f) -- "bind address comes from
# tailscale, not a literal"), so a tailnet rekey/IP change survives a restart
# instead of wedging the service on a stale address. If tailscaled is down at
# start, confirmd falls back to the last-known literal and Restart=on-failure
# retries until the tailnet is back (the unit already orders After=tailscaled).
Environment=CONFIRM_PORT=8443
Environment=CONFIRM_CERT=/home/swapd/confirmd/cert.crt
Environment=CONFIRM_KEY=/home/swapd/confirmd/key.pem
Environment=CONFIRM_OWNER=ntindle@github
Environment=CONFIRM_DIR=/home/swapd/approvals
ExecStart=/usr/bin/python3 /home/swapd/confirmd.py
Restart=on-failure
RestartSec=5
# Issue #77 (L8): cheap sandboxing for a network daemon. PrivateTmp is
# safe; ProtectSystem=full is safe (the page only writes under
# /home/swapd). NoNewPrivileges is intentionally NOT set: confirmd calls
# `sudo -n tailscale whois/status` under the narrow sudoers rule, and
# NoNewPrivileges would break sudo.
PrivateTmp=yes
ProtectSystem=full
# No host secrets are read by the page; it only writes approvals/.
# The jail cannot route here (jail firewall drops ve-jail).

[Install]
WantedBy=multi-user.target
