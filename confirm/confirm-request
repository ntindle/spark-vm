#!/usr/bin/env python3
"""confirm-request — file a pending approval for the confirmd page.

Finding 49: approvals carry structured fields (credential, host,
method, path_prefix, scope, amount, job), not free text. Finding 50:
the requester is the file's owner (the pending dir is setgid), never
an argument — only bdrive and swapd may file.

In production swapd files the item itself when it refuses a swap for
lack of a grant; this CLI is for testing the page end to end.

Usage:
  confirm-request --kind first-use --credential github \
      --host api.github.com --method GET --path-prefix /repos/ \
      --scope read --job test-job --ttl 3600
"""
import argparse
import json
import os
import uuid
from datetime import datetime, timedelta, timezone

APPROVALS = os.environ.get("CONFIRM_DIR", "/home/swapd/approvals")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--kind", required=True)
    ap.add_argument("--credential", required=True,
                    help="credential name the grant would unlock")
    ap.add_argument("--host", required=True)
    ap.add_argument("--method", default="GET")
    ap.add_argument("--path-prefix", default="/")
    ap.add_argument("--scope", default="")
    ap.add_argument("--amount", default="")
    ap.add_argument("--job", default="")
    ap.add_argument("--purpose", default="",
                    help="free text, shown labeled as untrusted")
    ap.add_argument("--ttl", type=int, default=3600,
                    help="seconds until the request expires")
    args = ap.parse_args()

    aid = uuid.uuid4().hex[:16]
    item = {
        "id": aid,
        "created": datetime.now(timezone.utc).isoformat(),
        "expires": (datetime.now(timezone.utc)
                    + timedelta(seconds=args.ttl)).isoformat(),
        "kind": args.kind,
        # Finding 49: structured, bound to the would-be grant.
        "credential": args.credential,
        "host": args.host,
        "method": args.method,
        "path_prefix": args.path_prefix,
        "scope": args.scope,
        "amount": args.amount,
        "job": args.job,
        # Free text is purpose only, rendered as untrusted.
        "detail": args.purpose,
        "summary": "%s %s%s for %s" % (args.method, args.host,
                                       args.path_prefix, args.credential),
    }
    d = os.path.join(APPROVALS, "pending")
    os.makedirs(d, exist_ok=True)
    # Finding 50: the file owner is the requester; the dir is setgid
    # so group stays consistent. No --requester argument exists.
    with open(os.path.join(d, aid + ".json"), "w") as f:
        json.dump(item, f, indent=2)
    print(aid)


if __name__ == "__main__":
    main()
