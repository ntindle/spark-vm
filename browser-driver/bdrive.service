[Unit]
Description=bdrive — Playwright browser driver daemon
After=network.target bdrive-firewall.service
Wants=network.target bdrive-firewall.service

[Service]
Type=simple
User=bdrive
# /run/bdrive is created here each boot (tmpfs); the nspawn jail
# bind-mounts it, so bdrive.service must be up before the jail starts
# (see the After=bdrive.service drop-in on systemd-nspawn@jail).
# Mode 2711: the daemon (owner) has full access; the jail agent (a
# userns-mapped uid that can never carry a host group) traverses via
# o+x; nobody lists the dir. DAC is not the peer gate (see bdrived).
#
# Finding 72: RuntimeDirectoryPreserve=yes. Without it, systemd
# removes /run/bdrive on stop and recreates it on start — while the
# jail holds a bind mount of the OLD directory inode, so the jail's
# socket path points at a directory the new daemon never sees.
# With the directory preserved, a restart recreates only the socket
# file (bdrived unlinks and rebinds it), and the jail's bind mount
# keeps working.
RuntimeDirectory=bdrive
RuntimeDirectoryMode=2711
RuntimeDirectoryPreserve=yes
Environment=BDRIVE_SOCKET=/run/bdrive/bdrive.sock
# Peer uids accepted by SO_PEERCRED. Finding 73: the default is EMPTY
# (accept nobody) — a missing drop-in fails closed. deploy.sh
# computes the jail agent's real host uid
# (map_base + the agent's guest uid from the jail rootfs, with
# map_base read from the .nspawn file) and overrides this via a
# drop-in. The obox uid is appended in round 9.
Environment=BDRIVE_PEER_UIDS=
# Browsers live in the bdrive user's cache (installed by deploy.sh).
Environment=PLAYWRIGHT_BROWSERS_PATH=/home/bdrive/.cache/ms-playwright
ExecStart=/home/bdrive/venv/bin/python /usr/local/bin/bdrived
Restart=on-failure
RestartSec=5
# The browser needs no more than this.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
